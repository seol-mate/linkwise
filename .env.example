# Neon PostgreSQL 연결 문자열 (https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Claude API (요약/태깅). 비워 두면 요약 없이 메타데이터만 수집한다.
ANTHROPIC_API_KEY=
# 요약에 쓸 모델 (선택). 기본값은 비용이 낮은 claude-haiku-5-5이며, 품질이 부족하면 claude-opus-5-5 등으로 바꾼다.
ANTHROPIC_MODEL=

# Auth.js (https://authjs.dev) — AUTH_SECRET은 `openssl rand -base64 32`로 생성
AUTH_SECRET=
# GitHub OAuth App (https://github.com/settings/developers)
# 콜백 URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
